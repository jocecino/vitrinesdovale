{
 "buildCommand": "node scripts/stamp.js",
 "outputDirectory": ".",
 "rewrites": [
  {
   "source": "/p/:id",
   "destination": "/api/s?t=p&id=:id"
  },
  {
   "source": "/l/:id",
   "destination": "/api/s?t=l&id=:id"
  }
 ],
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache, no-store, must-revalidate"
    },
    {
     "key": "Service-Worker-Allowed",
     "value": "/"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Content-Type-Options",
     "value": "nosniff"
    },
    {
     "key": "X-Frame-Options",
     "value": "SAMEORIGIN"
    },
    {
     "key": "Referrer-Policy",
     "value": "strict-origin-when-cross-origin"
    },
    {
     "key": "Permissions-Policy",
     "value": "camera=(), microphone=(), geolocation=()"
    },
    {
     "key": "Strict-Transport-Security",
     "value": "max-age=31536000"
    }
   ]
  }
 ]
}